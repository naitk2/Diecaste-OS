# AI provider: OpenAI is implemented by default. Keep this server-side only.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# MongoDB Atlas connection string and database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/diecaste-os?retryWrites=true&w=majority
MONGODB_DB=diecaste-os

# NextAuth keys. Generate a strong value with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-strong-random-secret
ADMIN_EMAIL=founder@example.com
ADMIN_PASSWORD=change-this-demo-password

# API protection.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=12
